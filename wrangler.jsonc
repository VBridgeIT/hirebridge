{
  // Cloudflare Worker settings for the H-1B Tracker. This file is the source of truth:
  // Workers Builds deploys main with `wrangler deploy` and every other branch with `wrangler preview`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hirebridge",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Serve Preview links at <preview>-hirebridge.<subdomain>.workers.dev (off by default since Wrangler 4.34)
  "preview_urls": true,
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },

  // HR users allowed into the app (a second lock behind Cloudflare Access). Change by pull request.
  "vars": { "HR_EMAILS": "hr@vbridgeit.com,ravitej@vbridgeit.com" },

  // Live data
  "d1_databases": [
    { "binding": "DB", "database_name": "hirebridge", "database_id": "3ab107cc-9536-462f-9c11-90e7c715db77" }
  ],

  // Preview links (one per branch / pull request): separate database, sample data allowed
  "previews": {
    "vars": { "HR_EMAILS": "hr@vbridgeit.com,ravitej@vbridgeit.com", "ALLOW_SAMPLE_DATA": "1" },
    "d1_databases": [
      { "binding": "DB", "database_name": "hirebridge-preview", "database_id": "118412c9-6465-4717-bb18-f2d1a96ffddf" }
    ]
  }
}
